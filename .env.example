# Copia este archivo a .env (local) o configúralo como secrets en Fly.io:
#   fly secrets set NOMBRE=valor -a finwat-node

PORT=3000

# Supabase (proyecto actual: tcltpyhxxgmwlhvztuba). Usa la service_role key:
# el bot busca usuarios por celular y escribe transacciones saltándose RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Gemini
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3-flash-preview; cámbialo si Google retira el modelo.
GEMINI_MODEL=gemini-3-flash-preview

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
